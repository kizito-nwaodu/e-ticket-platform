datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model UserAccount {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  displayName     String
  status          String           @default("active") // active, suspended
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  roleAssignments RoleAssignment[]
  scanAttempts    ScanAttempt[]
  checkIns        CheckIn[]
  auditLogs       AuditLog[]
}

model RoleAssignment {
  id             String       @id @default(uuid())
  userId         String
  role           String       // admin, organiser, supervisor, scanner_operator, auditor
  organizationId String?
  eventId        String?
  user           UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
}

model Event {
  id              String           @id @default(uuid())
  title           String
  description     String
  venue           String
  startAt         DateTime
  endAt           DateTime
  capacity        Int
  status          String           @default("draft") // draft, published, closed, cancelled
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ticketTypes     TicketType[]
  registrations   Registration[]
  gates           Gate[]
  roleAssignments RoleAssignment[]
  scanAttempts    ScanAttempt[]
  checkIns        CheckIn[]
}

model TicketType {
  id            String         @id @default(uuid())
  eventId       String
  name          String
  description   String?
  price         Float          @default(0.0)
  capacity      Int
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([eventId])
}

model Attendee {
  id             String         @id @default(uuid())
  fullName       String
  email          String
  phone          String?
  privacyConsent Boolean        @default(true) // NDPA 2023 compliance flag
  createdAt      DateTime       @default(now())
  registrations  Registration[]

  @@index([email])
}

model Registration {
  id            String         @id @default(uuid())
  eventId       String
  attendeeId    String
  ticketTypeId  String
  status        String         @default("approved") // pending, approved, waiting, cancelled
  reference     String         @unique // REG-XXXXXX
  registeredAt  DateTime       @default(now())
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee      Attendee       @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  ticketType    TicketType     @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  tickets       Ticket[]
  notifications Notification[]

  @@index([eventId, status])
  @@index([attendeeId])
}

model Ticket {
  id               String        @id @default(uuid())
  registrationId   String
  ticketNumber     String        @unique // TKT-XXXXXX
  token            String?       // Original plain security token for authorized delegate pass rendering
  tokenHash        String        @unique // SHA-256 of opaque cryptographically random secret
  status           String        @default("active") // active, revoked, expired, used
  issuedAt         DateTime      @default(now())
  validFrom        DateTime
  validTo          DateTime
  revocationReason String?
  registration     Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkIn          CheckIn?
  scanAttempts     ScanAttempt[]

  @@index([tokenHash])
  @@index([status])
}

model Gate {
  id           String        @id @default(uuid())
  eventId      String
  name         String
  status       String        @default("open") // open, closed
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scanAttempts ScanAttempt[]
  checkIns     CheckIn[]

  @@index([eventId])
}

model ScanAttempt {
  id                 String       @id @default(uuid())
  ticketId           String?
  eventId            String
  gateId             String?
  operatorId         String?
  tokenHashPresented String
  scannedAt          DateTime     @default(now())
  outcome            String       // admit, already_used, wrong_event, revoked, expired, not_found, review
  notes              String?
  ticket             Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  event              Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gate               Gate?        @relation(fields: [gateId], references: [id], onDelete: SetNull)
  operator           UserAccount? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([eventId, scannedAt])
  @@index([gateId, scannedAt])
}

model CheckIn {
  id               String       @id @default(uuid())
  ticketId         String       @unique // Guaranteed single admission per ticket at DB level
  eventId          String
  gateId           String?
  operatorId       String?
  checkedInAt      DateTime     @default(now())
  isManualOverride Boolean      @default(false)
  overrideReason   String?
  ticket           Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event            Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gate             Gate?        @relation(fields: [gateId], references: [id], onDelete: SetNull)
  operator         UserAccount? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([eventId, checkedInAt])
  @@index([gateId])
}

model AuditLog {
  id         String       @id @default(uuid())
  actorId    String?
  action     String       // EVENT_PUBLISHED, TICKET_REVOKED, TICKET_REISSUED, MANUAL_CHECKIN, REPORT_EXPORTED, USER_LOGIN, etc.
  targetType String
  targetId   String
  occurredAt DateTime     @default(now())
  metadata   String?      // JSON string of event payload or context
  actor      UserAccount? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, occurredAt])
  @@index([targetType, targetId])
}

model Notification {
  id             String       @id @default(uuid())
  registrationId String
  channel        String       @default("web") // web, email, sms
  template       String
  status         String       @default("sent") // queued, sent, failed
  sentAt         DateTime     @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}
