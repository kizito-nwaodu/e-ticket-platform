{
  "name": "etickets-server",
  "version": "1.0.0",
  "description": "Integrated E-Ticketing and Event Management Platform Backend API (PGDI 720)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "ts-node-dev --transpile-only prisma/seed.ts",
    "test:acceptance": "ts-node-dev --transpile-only src/tests/acceptance.ts",
    "test:roles": "ts-node-dev --transpile-only src/tests/testRoleAccess.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {}
}
